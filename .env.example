# ─── Database ────────────────────────────────────────────────
DB_USER=petshop
DB_PASSWORD=change_me_strong_password
DB_NAME=petshop
DATABASE_URL=postgresql://petshop:change_me_strong_password@localhost:5432/petshop

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# ─── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=petshop
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=petshop-images
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Sample Store <orders@example.com>
# Backend brand name used in email subjects + branded email layout (default 'Sample Store')
# BRAND_NAME=Sample Store
# BRAND_COLOR is a literal hex — intentional duplicate of the app's brand.css
# --brand-primary, because email clients can't read CSS variables.
BRAND_COLOR="#c97b5a"
# BRAND_LOGO_URL=                 # optional absolute URL for the email header; empty → text header
# SITE_URL=http://localhost:3000  # optional; defaults to NUXT_URL if unset

# ─── Mail transport ───────────────────────────────────────────
# smtp → local Mailpit catcher (web UI http://localhost:8025); resend → real send.
# Unset defaults to 'resend' (prod-safe); this kit ships 'smtp' for local testing.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost        # use 'mailpit' when running via docker-compose
SMTP_PORT=1025
# RESEND_API_KEY above is only required when MAIL_TRANSPORT=resend

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development

# Seed demo logins (admin@demo.com/admin, user@demo.com/user) and a sample
# catalogue. Anything other than "true" seeds baseline settings only.
# NEVER set this to true on a production store — start.sh runs the seed on every
# container boot, so a demo admin would be recreated after every deploy.
SEED_DEMO_DATA=true
NUXT_PUBLIC_API_BASE=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend CORS allow-list (used when NODE_ENV=production). Comma-separated for multiple origins.
# Dev (NODE_ENV=development) ignores this and allows any http://localhost:<port>.
# e.g. NUXT_URL=https://example.com,http://localhost:3000
NUXT_URL=http://localhost:3000

# Google OAuth — from Google Cloud Console (APIs & Services → Credentials → OAuth client ID, Web app)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
