generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Settings ────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── Users / Profiles ────────────────────────────────────────

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  fullName      String?   @map("full_name")
  phone         String?
  googleId      String?   @unique @map("google_id")
  provider      String    @default("local")
  avatarUrl     String?   @map("avatar_url")
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  orders              Order[]
  favourites          Favourite[]
  loyaltyTransactions LoyaltyTransaction[]
  refreshTokens       RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum UserRole {
  CUSTOMER      @map("customer")
  ADMIN         @map("admin")
  ACCOUNTANT    @map("accountant")
  STOCK_MANAGER @map("stock_manager")

  @@map("user_role")
}

// ─── Categories ──────────────────────────────────────────────

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  nameEl    String     @map("name_el")
  nameEn    String     @map("name_en")
  parentId  String?    @map("parent_id") @db.Uuid
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@map("categories")
}

// ─── Products ────────────────────────────────────────────────

model Product {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String     @unique
  nameEl        String     @map("name_el")
  nameEn        String     @map("name_en")
  descriptionEl String?    @map("description_el")
  descriptionEn String?    @map("description_en")
  price         Decimal    @db.Decimal(10, 2)
  compareAtPrice Decimal?  @db.Decimal(10, 2) @map("compare_at_price")
  cost          Decimal?   @db.Decimal(10, 2)
  stock         Int        @default(0)
  isActive      Boolean    @default(true) @map("is_active")
  categoryId    String?    @map("category_id") @db.Uuid
  brand         String?
  images        String[]   @default([])
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  favourites Favourite[]

  @@index([categoryId])
  @@index([brand])
  @@index([isActive])
  @@index([slug])
  @@map("products")
}

// ─── Orders ──────────────────────────────────────────────────

model Order {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String?       @map("user_id") @db.Uuid
  guestEmail            String?       @map("guest_email")
  status                OrderStatus   @default(PENDING)
  fulfillmentType       FulfillmentType @map("fulfillment_type")
  paymentMethod         PaymentMethod @map("payment_method")
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeSessionId       String?       @map("stripe_session_id")
  subtotal              Decimal       @db.Decimal(10, 2)
  shippingCost          Decimal       @default(0) @db.Decimal(10, 2) @map("shipping_cost")
  loyaltyDiscount       Decimal       @default(0) @db.Decimal(10, 2) @map("loyalty_discount")
  total                 Decimal       @db.Decimal(10, 2)
  shippingAddress       Json?         @map("shipping_address")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at")

  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2) @map("unit_price")
  productName  String   @map("product_name")
  productPrice Decimal  @db.Decimal(10, 2) @map("product_price")
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  PROCESSING @map("processing")
  READY      @map("ready")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")

  @@map("order_status")
}

enum FulfillmentType {
  SHIPPING @map("shipping")
  PICKUP   @map("pickup")

  @@map("fulfillment_type")
}

enum PaymentMethod {
  STRIPE        @map("stripe")
  CASH_ON_PICKUP @map("cash_on_pickup")
  CARD_ON_PICKUP @map("card_on_pickup")

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  FAILED   @map("failed")
  REFUNDED @map("refunded")

  @@map("payment_status")
}

// ─── Loyalty ─────────────────────────────────────────────────

model LoyaltyTransaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  orderId     String?         @map("order_id") @db.Uuid
  pointsDelta Int             @map("points_delta")
  type        LoyaltyType
  createdAt   DateTime        @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("loyalty_transactions")
}

enum LoyaltyType {
  EARN   @map("earn")
  REDEEM @map("redeem")

  @@map("loyalty_type")
}

// ─── Favourites ──────────────────────────────────────────────

model Favourite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favourites")
}

// ─── Newsletter ──────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// ─── Payment webhook idempotency ─────────────────────────────

/// One row per payment-provider webhook event that has been fully applied.
///
/// The event id is the primary key, so the insert itself is the idempotency
/// guard. It is written inside the same transaction as the order and loyalty
/// writes: a duplicate delivery hits the unique violation and rolls the whole
/// transaction back, which is what makes two concurrent deliveries safe. A
/// check-then-act guard would not be.
model ProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  orderId     String?  @map("order_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_events")
}

// ─── Notifications (admin) ───────────────────────────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      NotificationType
  productId String?          @map("product_id") @db.Uuid
  stock     Int?
  meta      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt])
  @@index([productId])
  @@map("notifications")
}

enum NotificationType {
  LOW_STOCK    @map("low_stock")
  OUT_OF_STOCK @map("out_of_stock")

  @@map("notification_type")
}
