// ─── Infrastructure (ARCHITECTURE-BLUEPRINT §9) ──────────────
//
// Technical persistence with no domain meaning.

// ─── Payment webhook idempotency ─────────────────────────────

/// One row per payment-provider webhook event that has been fully applied.
///
/// The event id is the primary key, so the insert itself is the idempotency
/// guard. It is written inside the same transaction as the order and loyalty
/// writes: a duplicate delivery hits the unique violation and rolls the whole
/// transaction back, which is what makes two concurrent deliveries safe. A
/// check-then-act guard would not be.
model ProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  /// What the event was about, as the provider named it (an order id today).
  /// Provider-neutral text: the ledger belongs to Infrastructure, not to orders.
  subjectId   String?  @map("subject_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_events")
}
