// ─── E-commerce module (ARCHITECTURE-BLUEPRINT §9) ───────────
//
// Owned by the shop: catalogue, orders, loyalty, favourites and their enums.
// The relation fields on `User` these models point at are declared in
// core.prisma (Prisma keeps a model in one block).

// ─── Categories ──────────────────────────────────────────────

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  nameEl    String     @map("name_el")
  nameEn    String     @map("name_en")
  parentId  String?    @map("parent_id") @db.Uuid
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@map("categories")
}

// ─── Products ────────────────────────────────────────────────

model Product {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String     @unique
  nameEl        String     @map("name_el")
  nameEn        String     @map("name_en")
  descriptionEl String?    @map("description_el")
  descriptionEn String?    @map("description_en")
  price         Decimal    @db.Decimal(10, 2)
  compareAtPrice Decimal?  @db.Decimal(10, 2) @map("compare_at_price")
  cost          Decimal?   @db.Decimal(10, 2)
  stock         Int        @default(0)
  isActive      Boolean    @default(true) @map("is_active")
  categoryId    String?    @map("category_id") @db.Uuid
  brand         String?
  images        String[]   @default([])
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  favourites Favourite[]

  @@index([categoryId])
  @@index([brand])
  @@index([isActive])
  @@index([slug])
  @@map("products")
}

// ─── Orders ──────────────────────────────────────────────────

model Order {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String?       @map("user_id") @db.Uuid
  guestEmail            String?       @map("guest_email")
  status                OrderStatus   @default(PENDING)
  fulfillmentType       FulfillmentType @map("fulfillment_type")
  paymentMethod         PaymentMethod @map("payment_method")
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeSessionId       String?       @map("stripe_session_id")
  subtotal              Decimal       @db.Decimal(10, 2)
  shippingCost          Decimal       @default(0) @db.Decimal(10, 2) @map("shipping_cost")
  loyaltyDiscount       Decimal       @default(0) @db.Decimal(10, 2) @map("loyalty_discount")
  total                 Decimal       @db.Decimal(10, 2)
  shippingAddress       Json?         @map("shipping_address")
  notes                 String?
  // Client idempotency (POST /orders `Idempotency-Key`): the key, scoped to the
  // buyer, and a digest of the payload it was first used with. Written in the
  // same transaction as the order, so a key is "taken" exactly when its order
  // commits and never by a failed attempt.
  idempotencyKey        String?       @unique @map("idempotency_key")
  idempotencyHash       String?       @map("idempotency_hash")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at")

  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2) @map("unit_price")
  productName  String   @map("product_name")
  productPrice Decimal  @db.Decimal(10, 2) @map("product_price")
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  PROCESSING @map("processing")
  READY      @map("ready")
  COMPLETED  @map("completed")
  CANCELLED  @map("cancelled")

  @@map("order_status")
}

enum FulfillmentType {
  SHIPPING @map("shipping")
  PICKUP   @map("pickup")

  @@map("fulfillment_type")
}

enum PaymentMethod {
  STRIPE        @map("stripe")
  CASH_ON_PICKUP @map("cash_on_pickup")
  CARD_ON_PICKUP @map("card_on_pickup")

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  FAILED   @map("failed")
  REFUNDED @map("refunded")

  @@map("payment_status")
}

// ─── Loyalty ─────────────────────────────────────────────────

// One row per user who has ever earned points; absent row = 0 points. Replaces
// the former `users.loyalty_points` column (seam 2). Written only by
// src/loyalty/loyalty.service.ts, always alongside a LoyaltyTransaction.
model LoyaltyAccount {
  userId    String   @id @map("user_id") @db.Uuid
  points    Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  orderId     String?         @map("order_id") @db.Uuid
  pointsDelta Int             @map("points_delta")
  type        LoyaltyType
  createdAt   DateTime        @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("loyalty_transactions")
}

enum LoyaltyType {
  EARN   @map("earn")
  REDEEM @map("redeem")

  @@map("loyalty_type")
}

// ─── Favourites ──────────────────────────────────────────────

model Favourite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favourites")
}
